# Local testing secrets template for Firebase Functions Emulator
# Copy this file to functions/.secret.local and insert your newly rotated Mailjet credentials.
# NOTE: functions/.secret.local is strictly gitignored and must NEVER be committed.
MAILJET_API_KEY=YOUR_ROTATED_MAILJET_API_KEY
MAILJET_SECRET_KEY=YOUR_ROTATED_MAILJET_SECRET_KEY
